{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-sanitize",
      "displayName": "Debug + ASan/UBSan",
      "binaryDir": "${sourceDir}/build/debug-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TICKFORGE_ENABLE_ASAN": "ON",
        "TICKFORGE_ENABLE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug-sanitize", "configurePreset": "debug-sanitize" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-sanitize",
      "configurePreset": "debug-sanitize",
      "output": { "outputOnFailure": true },
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1",
        "ASAN_OPTIONS": "alloc_dealloc_mismatch=1"
      }
    }
  ]
}
